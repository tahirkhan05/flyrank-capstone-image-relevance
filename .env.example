# ContextLens Environment Configuration
# Copy this file to .env and fill in your actual values. Never commit .env to version control!

# Gemini API Key (obtain free from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
APP_ENV=development
APP_PORT=8000
DATABASE_URL=sqlite:///./contextlens.db

# Matching & Mismatch Guard Thresholds
CONFIDENCE_THRESHOLD=0.75
SIMILARITY_THRESHOLD=0.65
